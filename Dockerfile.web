ARG PYTHON_VERSION=3.11

FROM python:${PYTHON_VERSION}-slim AS runtime

ARG PYTHON_VERSION
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# The web UI reuses models.config (pydantic) and core.constants from the recorder.
COPY pyproject.toml poetry.lock ./
RUN pip install --no-cache-dir poetry==2.4.1 \
    && poetry config virtualenvs.create false \
    && poetry install --only main --no-interaction --no-ansi \
    && pip uninstall -y poetry

# Web-only dependencies. Kept out of the main group so the recorder image is
# unchanged; python-multipart is required for the HTML form posts.
RUN pip install --no-cache-dir \
    "fastapi>=0.115" \
    "uvicorn[standard]>=0.30" \
    "jinja2>=3.1" \
    "python-multipart>=0.0.9"

COPY . .

# Host project directory: .env, config/, archive/ and logs/ all live under it.
ENV RPLAY_HOST_ROOT=/host

EXPOSE 8099

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8099/healthz')"

CMD ["uvicorn", "web.app:app", "--host", "0.0.0.0", "--port", "8099"]
